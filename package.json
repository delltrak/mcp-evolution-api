{
  "name": "mcp-evolution-api",
  "version": "1.0.0",
  "description": "MCP Server para Evolution API v2 - conecta modelos de linguagem ao WhatsApp",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-evolution-api": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "docker:build": "docker build -t mcp-evolution-api .",
    "docker:run": "docker run -p 4899:4899 --env-file .env mcp-evolution-api",
    "docker:compose": "docker-compose up -d",
    "setup": "node scripts/generate-env.js",
    "deploy": "npm run build && npm run setup && npm run docker:compose",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mcp",
    "evolution-api",
    "whatsapp",
    "ai",
    "llm",
    "claude",
    "gpt"
  ],
  "author": "IntuitivePhella",
  "repository": {
    "type": "git",
    "url": "https://github.com/IntuitivePhella/mcp-evolution-api"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.11.0",
    "axios": "^1.8.4",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "typescript": "^5.3.3",
    "ws": "^8.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.17",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
